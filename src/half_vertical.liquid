<div class="layout layout--col layout--center layout--middle">
  {% if ok == false %}
    <span class="value value--small">Not found</span>
  {% elsif hidden %}
    <span class="value value--small">Hidden</span>
  {% else %}
    <span class="value value--large lg:value--xlarge portrait:value--large value--tnums">{{ count_text }}</span>
    <span class="label">subscribers</span>
    {% if delta_text %}
      <span class="label label--small">{{ delta_text }}</span>
    {% endif %}
  {% endif %}
</div>

<div class="title_bar">
  <img class="image" src="data:image/svg+xml;base64,{{ icon_svg | base64_encode }}" width="24" height="24">
  <span class="title">{{ title | default: "YouTube" }}</span>
  <span class="instance">{{ trmnl.plugin_settings.instance_name }}</span>
</div>
